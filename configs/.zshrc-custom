
# Kiro CLI pre block. Keep at the top of this file.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh"

# zsh only — do not source this file from bash (Oh My Zsh needs $ZSH_VERSION; bash + set -u breaks).
case ${ZSH_VERSION-} in
  '') return 0 ;;
esac

# Powerlevel10k instant prompt. Must stay near the top: everything below runs after the
# prompt is already drawn. Code that needs console input must go above this block.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Homebrew shell setup (Apple Silicon + Intel fallback)
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# SSH: load keys whose passphrases are stored in the macOS keychain. New keys are added
# on first use via "AddKeysToAgent yes" + "UseKeychain yes" in ~/.ssh/config (setup-ssh.sh).
ssh-add --apple-load-keychain &> /dev/null

# Update PATHs
export DOCKER_BIN=$HOME/.docker/bin
export PATH="$DOCKER_BIN:$PATH"

# nvm: Node versions live in ~/.nvm (outside the Homebrew keg, so `brew upgrade nvm` keeps them).
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  . "$NVM_DIR/nvm.sh"
elif [[ -n "${HOMEBREW_PREFIX-}" && -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ]]; then
  . "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"
fi

# Oh My Zsh setup (ZSH_THEME must be set before oh-my-zsh.sh; the prompt comes from Powerlevel10k)
export ZSH="${HOME}/.oh-my-zsh"
ZSH_THEME=""
plugins=(git autojump docker docker-compose)
[[ -n "${HOMEBREW_PREFIX-}" ]] && fpath+=("$HOMEBREW_PREFIX/share/zsh/site-functions")
source "$ZSH/oh-my-zsh.sh"

# Powerlevel10k setup
# https://github.com/romkatv/powerlevel10k
source ~/.oh-my-zsh/custom/themes/powerlevel10k/powerlevel10k.zsh-theme
# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# fzf key bindings (Ctrl-R, Ctrl-T, Alt-C) and completion
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# Aikido Safe Chain (installed by setup-50)
[[ -f ~/.safe-chain/scripts/init-posix.sh ]] && source ~/.safe-chain/scripts/init-posix.sh

# Run nvm use when entering a directory with a .nvmrc file
function nvm_auto_use() {
  if [[ -f .nvmrc ]]; then
    nvm use
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd nvm_auto_use


# Welcome the user
echo "Welcome back" $(id -F | awk '{print $1;}')"! 🚀 (Tip: Use 'custom-aliases' to see all aliases)"


# Load local env/secrets from ~/.env if present
[[ -f "${HOME}/.env" ]] && source "${HOME}/.env"

# Kiro CLI post block. Keep at the bottom of this file.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh"
